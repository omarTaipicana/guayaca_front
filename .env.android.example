# Solo para npm run build:android. Mantén tu .env local para Vite web.
VITE_API_URL=https://api.guayacatransport.com/api

# Opcional: World Imagery (Esri), con una clave que tenga permiso Basemaps.
# VITE_ARCGIS_API_KEY=

# Alternativa: Stadia Maps, si no hay una clave de ArcGIS configurada.
# VITE_STADIA_MAPS_API_KEY=
